---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import HeaderBottom from './HeaderBottom.astro';
import Footer from './Footer.astro';
import Section from './Section.astro';
import FactGrid from './FactGrid.astro';
import Gallery, { type GalleryItem } from './Gallery.astro';
import type { Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  current: 'kimon' | 'irida';
  mapFocus: 'kimon' | 'irida';
  heroClass: string;
  resort: { title: string; main: string; facilitiesTitle: string; gallery: string };
  facilityCol1: string[];
  facilityCol2: string[];
  items: GalleryItem[];
  figureClass: string;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  current,
  mapFocus,
  heroClass,
  resort,
  facilityCol1,
  facilityCol2,
  items,
  figureClass,
} = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} canonicalPath={canonicalPath}>
  <Navbar lang={lang} canonicalPath={canonicalPath} current={current} />
  <HeaderBottom lang={lang} />

  <Section>
    <div class="grid grid--2">
      <div data-reveal>
        <h1>{resort.title}</h1>
        <p class="lead">{resort.main}</p>
      </div>
      <div data-reveal data-reveal-delay="120">
        <h2>{resort.facilitiesTitle}</h2>
        <FactGrid columns={2} items={[...facilityCol1, ...facilityCol2].map((label) => ({ label }))} />
      </div>
    </div>
  </Section>

  <Section ground="sand">
    <h2>{resort.gallery}</h2>
    <Gallery items={items} figureClass={figureClass} />
  </Section>

  <Footer lang={lang} mapFocus={mapFocus} />
</BaseLayout>
