---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/t';
import { API_ENDPOINTS, RECAPTCHA_SITE_KEY } from '../config';
import Icon from './Icon.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const s = t(lang);
const f = s.contact.form;
---

<div class="contact-form">
  <section>
    <h3 class="contact-form__title">{s.contact.title}</h3>
    <p class="contact-form__description">{s.contact.main}</p>

    <form id="contact-form" method="post" class="contact-form__form" novalidate>
      <div class="field">
        <input type="text" id="contact_name" name="contact_name" class="field__input" placeholder="Name" />
        <div class="field-error" data-for="contact_name" style="color:red;display:none"></div>
      </div>
      <div class="field">
        <input type="email" id="contact_email" name="contact_email" class="field__input" placeholder="Email" />
        <div class="field-error" data-for="contact_email" style="color:red;display:none"></div>
      </div>
      <div class="field">
        <input type="text" id="contact_subject" name="contact_subject" class="field__input" placeholder="Subject" />
        <div class="field-error" data-for="contact_subject" style="color:red;display:none"></div>
      </div>
      <div class="field">
        <textarea id="contact_message" name="contact_message" class="field__input" rows="6" placeholder="Message"></textarea>
        <div class="field-error" data-for="contact_message" style="color:red;display:none"></div>
      </div>

      <div class="contact-form-messages">
        <div id="generic-loader" class="text-center" style="display:none">Sending email... <Icon name="spinner" /></div>
        <div id="error_message" style="display:none">{s.contact.contactErrorMessage}</div>
        <div id="success_message" style="display:none">{s.contact.contactSuccessMessage}</div>
        <div id="recaptcha_message" style="color:red;display:none">{s.contact.captchaErrorMessage}</div>
      </div>

      <button type="submit" id="contact-form-submit" class="btn btn--primary">{s.contact.submit}</button>
      <div class="g-recaptcha" data-sitekey={RECAPTCHA_SITE_KEY}></div>
    </form>
  </section>
</div>

<style>
  .contact-form { max-width: 40rem; margin-inline: auto; }
  .contact-form__title { font-size: var(--fs-display-l); margin-bottom: var(--sp-3); }
  .contact-form__description { margin-bottom: var(--sp-6); }
  .field { margin-bottom: var(--sp-4); }
  .field__input {
    display: block; width: 100%; min-height: 44px;
    padding: var(--sp-3) var(--sp-4);
    font: inherit; color: var(--c-ink); background: var(--c-white);
    border: 1px solid var(--c-deep-sea); border-radius: var(--radius-btn);
  }
  .field__input:focus-visible { outline: 2px solid var(--c-sivota-blue); outline-offset: 2px; }
  .contact-form__form :global(.btn) { margin-block: var(--sp-4); }
  /* Google's widget is a fixed 304px, wider than a 320px viewport's content box.
     Scaling keeps the whole checkbox visible; clipping would cut its right edge. */
  @media (max-width: 360px) {
    .contact-form__form :global(.g-recaptcha) {
      transform: scale(0.9); transform-origin: 0 0; height: 70px;
    }
  }
</style>

<script
  define:vars={{
    endpoints: API_ENDPOINTS,
    messages: { required: f.required, validEmail: f.validEmail, minlength3: f.minlength3, minlength5: f.minlength5, minlength10: f.minlength10 },
  }}
>
  const form = document.getElementById('contact-form');
  if (form) {
    const $ = (id) => document.getElementById(id);
    const show = (id, on) => { const el = $(id); if (el) el.style.display = on ? 'block' : 'none'; };
    const flash = (id) => { show(id, true); setTimeout(() => show(id, false), 1500); };

    const setError = (name, msg) => {
      const box = document.querySelector(`.field-error[data-for="${name}"]`);
      if (box) { box.textContent = msg || ''; box.style.display = msg ? 'block' : 'none'; }
      return !msg;
    };

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const validate = () => {
      const v = (id) => ($(id).value || '').trim();
      let ok = true;
      ok = setError('contact_name', !v('contact_name') ? messages.required : v('contact_name').length < 3 ? messages.minlength3 : '') && ok;
      ok = setError('contact_email', !v('contact_email') ? messages.required : !emailRe.test(v('contact_email')) ? messages.validEmail : '') && ok;
      ok = setError('contact_subject', !v('contact_subject') ? messages.required : v('contact_subject').length < 5 ? messages.minlength5 : '') && ok;
      ok = setError('contact_message', !v('contact_message') ? messages.required : v('contact_message').length < 10 ? messages.minlength10 : '') && ok;
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      // reCAPTCHA response tokens are SINGLE-USE: Google's siteverify consumes a
      // token on first verification and answers `timeout-or-duplicate` to every
      // later attempt with the same value. So there can be exactly one verifier,
      // and it is /contact (the endpoint that actually sends the mail). A
      // pre-submit call to /validaterecaptcha would burn the token and make the
      // subsequent /contact verification fail for every legitimate submission.
      // All the client can do without burning the token is check it is present.
      //
      // Deliberately NO grecaptcha.reset() here, unlike the 403 branch below.
      // An empty getResponse() means the widget is holding nothing: either the
      // challenge is unsolved, or it expired and grecaptcha already cleared
      // itself and re-armed the checkbox. There is no spent token to clear, and
      // a reset would wipe a challenge the user is part-way through solving.
      const token = (window.grecaptcha && window.grecaptcha.getResponse()) || '';
      if (!token) { flash('recaptcha_message'); return; }

      show('generic-loader', true);
      try {
        const payload = {
          name: $('contact_name').value,
          email: $('contact_email').value,
          subject: $('contact_subject').value,
          message: $('contact_message').value,
          captchaResponse: token,
        };
        // Content-Type matches the legacy jQuery default (form-urlencoded) so the
        // request stays CORS-simple (no preflight) and the body is delivered as a
        // JSON string, which is what the Lambda parses.
        const res = await fetch(endpoints.contact, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
          body: JSON.stringify(payload),
        });
        show('generic-loader', false);
        const data = await res.json().catch(() => ({}));
        // The integration is non-proxy, so API Gateway discards the Lambda's
        // statusCode and answers HTTP 200 with the whole envelope as the body:
        // {"statusCode":403,"body":"{\"error\":\"captcha rejected\"}"}. The
        // verdict therefore lives in data.statusCode. res.status is checked as
        // well so this keeps reading correctly if the integration is ever
        // converted to a proxy one.
        const parsed = typeof data.body === 'string' ? JSON.parse(data.body) : data;
        if (parsed.ok !== true) {
          if (data.statusCode === 403 || res.status === 403) {
            // A 403 means Google rejected this token, so it is spent either way
            // — wrong, expired, or already consumed. The widget still holds it,
            // so without a reset every retry would resend the same dead token
            // and get another 403, leaving the user stuck until they reload.
            // Resetting hands them a fresh challenge they can actually retry.
            if (window.grecaptcha) window.grecaptcha.reset();
            flash('recaptcha_message');
            return;
          }
          throw new Error('send rejected');
        }
        form.reset();
        flash('success_message');
        if (window.grecaptcha) window.grecaptcha.reset();
      } catch {
        show('generic-loader', false);
        flash('error_message');
      }
    });
  }
</script>
