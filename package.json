{
  "name": "marinos-aparts",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "check:links": "linkinator http://localhost:4321/en/ http://localhost:4321/gr/ --recurse --silent --skip \"^https?://(www\\.)?(marinos-aparts\\.gr|okairos|unpkg|photoswipe|facebook|instagram|reservations\\.bookoncloud|googletagmanager|google\\.com|gstatic)\"",
    "check:links:ci": "astro build && (astro preview & SERVER_PID=$!; trap 'kill $SERVER_PID 2>/dev/null' EXIT; i=0; until curl -sf http://localhost:4321/en/ >/dev/null; do i=$((i+1)); if [ $i -ge 30 ]; then echo 'preview server did not answer on :4321 within 30s' >&2; exit 1; fi; sleep 1; done; npm run check:links)",
    "build:info": "node scripts/build-info.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^4.15.0",
    "leaflet": "^1.9.4",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-ses": "^3.1140.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "linkinator": "^8.1.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "yaml": "^2.9.0"
  }
}
